# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ===== Dependencies =====
node_modules/
**/node_modules/

# ===== Frontend (React Native / Expo) =====
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# Native build artifacts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Generated native folders
frontend/ios/
frontend/android/

# ===== Backend (Node.js / Express) =====
backend/logs/
backend/*.log

# ===== Environment variables (NEVER commit secrets) =====
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# ===== Debug logs =====
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
*.log

# ===== OS =====
.DS_Store
Thumbs.db
*.pem

# ===== Editors =====
.vscode/
.idea/
*.swp
*.swo

# ===== TypeScript =====
*.tsbuildinfo

# ===== Misc =====
.cache/
coverage/
*.tmp
